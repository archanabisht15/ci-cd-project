pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build & Test') {
            steps { sh 'mvn clean package' }
        }
        stage('Archive') {
            steps { archiveArtifacts artifacts: 'target/*.war', fingerprint: true }
        }
    }
    post {
        success { echo 'Build successful' }
        failure { echo 'Build failed' }
    }
}
